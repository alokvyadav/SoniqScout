# ---- Supabase (Project Settings -> API) ----
# Public values, shipped to the browser. Use the anon / publishable key, NEVER the service_role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Same values again, read by server functions (no VITE_ prefix).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# ---- AI review engine (any OpenAI-compatible chat-completions API) ----
# Server-only secret. Example: Google Gemini (has a free tier; check current model names)
AI_API_KEY=YOUR-AI-API-KEY
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash
# OpenAI example:  AI_BASE_URL=https://api.openai.com/v1   AI_MODEL=gpt-4o-mini
